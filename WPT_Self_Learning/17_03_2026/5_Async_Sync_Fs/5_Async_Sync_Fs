// fileHandling.js
const fs = require("fs");

fs.writeFileSync("data.txt", "Hello Vikrant!\nWelcome to Node.js File Handling.");


fs.readFile("data.txt", "utf8", (err, data) => {
    if (err) {
        console.log("Error reading file:", err);
    } else {
        console.log("File Content:\n" + data);
    }
});